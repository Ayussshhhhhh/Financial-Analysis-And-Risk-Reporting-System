# ============================================================
# Financial Analytics and Risk Reporting System — .gitignore
# ============================================================

# ----------------------------------------------------------
# Python bytecode & cache
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.mypy_cache/
.pytype/
.ruff_cache/
*.so

# ----------------------------------------------------------
# Virtual environments
# ----------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ----------------------------------------------------------
# Environment variable files (secrets)
# ----------------------------------------------------------
.env
*.env
config/secrets.yaml
config/secrets.yml

# ----------------------------------------------------------
# Jupyter Notebooks (keep notebooks/, ignore auto-saves)
# ----------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ignore auto-saved / untitled notebooks but keep committed ones
# If you want to ignore ALL .ipynb, uncomment the next line:
# *.ipynb

# ----------------------------------------------------------
# Data files — raw, staging, curated
# ----------------------------------------------------------
data/raw/*.csv
data/raw/*.tsv
data/raw/*.json
data/staging/*.csv
data/staging/*.tsv
data/staging/*.parquet
data/curated/*.db
data/curated/*.sqlite
data/curated/*.sqlite3
data/outputs/*.csv
data/outputs/*.json

# ----------------------------------------------------------
# Excel temporary / lock files
# ----------------------------------------------------------
~$*.xlsx
~$*.xlsm
~$*.xls
~$*.xlsb

# ----------------------------------------------------------
# Generated reports (keep templates, ignore generated PDFs)
# ----------------------------------------------------------
reports/monthly_board_pack/*.pdf
reports/financial_report/*.pdf

# ----------------------------------------------------------
# Serialised models & artefacts
# ----------------------------------------------------------
*.pkl
*.joblib
*.pickle
# Keep intentionally committed models:
!models/*.pkl
!models/*.joblib

# ----------------------------------------------------------
# Logs
# ----------------------------------------------------------
logs/*.log
logs/**/*.log
*.log

# ----------------------------------------------------------
# Build / packaging artefacts
# ----------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
pip-wheel-metadata/
share/python-wheels/

# ----------------------------------------------------------
# Operating system artefacts
# ----------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ----------------------------------------------------------
# IDE / editor
# ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.spyderproject.cfg
.spyproject/
.ropeproject/

# ----------------------------------------------------------
# Testing & coverage
# ----------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml

# ----------------------------------------------------------
# Miscellaneous
# ----------------------------------------------------------
*.bak
*.tmp
*.temp
